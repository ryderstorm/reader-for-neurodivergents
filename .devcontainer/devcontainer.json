{
  "name": "Reader for Neurodivergents Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "containerEnv": {
    "HF_HUB_OFFLINE": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "postCreateCommand": "uv sync --python 3.12 && npm ci --no-audit --no-fund",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh"
}
