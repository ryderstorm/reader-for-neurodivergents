# Runtime configuration for Reader for Neurodivergents
# Copy to .env for local overrides (never commit .env).

# Port to listen on (default: 8765)
PORT=8765

# Bind address; use 0.0.0.0 to expose on your LAN (default: 127.0.0.1)
HOST=127.0.0.1

# Compute device for Kokoro-82M: auto, cuda, or cpu (default: auto)
T2S_DEVICE=auto

# Set to 0 to prevent scripts-tools/run.sh from launching a browser (default: 1)
OPEN=1

# Optional TLS paths for HTTPS (required to install as a PWA on a phone)
# T2S_SSL_CERT=certs/server.crt
# T2S_SSL_KEY=certs/server.key

# Comma-separated allowed CORS origins; restrict on public deployments (default: *)
T2S_CORS_ORIGINS=*
