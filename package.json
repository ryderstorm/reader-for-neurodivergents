{
  "name": "reader-for-neurodivergents",
  "version": "1.1.3",
  "private": true,
  "description": "Tooling and test harness for Reader for Neurodivergents",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-include='web/js/**/*.js' tests/js/*.test.mjs",
    "test:unit": "node --test tests/js/*.test.mjs",
    "test:e2e": "node tests/e2e/live_server.test.mjs",
    "lint": "eslint web/js tests scripts-tools/test_frontend.mjs",
    "format": "prettier --write \"web/js/**/*.js\" \"tests/**/*.mjs\"",
    "format:check": "prettier --check \"web/js/**/*.js\" \"tests/**/*.mjs\"",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "24.1.3",
    "knip": "^5.50.0",
    "prettier": "^3.5.3"
  }
}
